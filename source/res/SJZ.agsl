const vec4 WHITE_COLOR = vec4(1.0, 1.0, 1.0, 0.0);
uniform vec2 uStart;
uniform vec2 uSize;
uniform shader uInput;
uniform float uGradientStartOffset;
uniform float uTranslateX;
uniform float uTranslateY;

vec4 main(in vec2 fragCoord) {
    vec2 originCoord = vec2(fragCoord.x, fragCoord.y);
    fragCoord.y = fragCoord.y - uTranslateY;
    fragCoord.x = fragCoord.x - uTranslateX;
    vec4 resultColor = vec4(0.0);
    if(fragCoord.x < uStart.x || fragCoord.x > uSize.x + uStart.x){
       resultColor = WHITE_COLOR;
    }else{
        vec4 color = uInput.eval(vec2(originCoord.x - uStart.x, originCoord.y - uStart.y));
        $GRADIENT_CODE$
    }
    return vec4(resultColor.r * resultColor.a, resultColor.g * resultColor.a, resultColor.b * resultColor.a, resultColor.a);
}

