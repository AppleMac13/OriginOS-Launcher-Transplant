// 该渲染器的模型是以一个 uStartX 为起始位置的 Shader 窗口，通过 uTranslateX 将目标 View 的左起始点与 Shader 窗口尾部对齐，随时间逐步向左移动，完成从右->左着色色表颜色的过程
// HDR 起始位置百分比
uniform float uHdrStartPercent;
uniform float uTranslateX;
uniform float uTranslateY;
uniform float uStartX;
uniform float uEndX;
$DYNAMIC_COLOR_PARAMS$

// 主函数
vec4 main(in vec2 fragCoord) {
    float startX = uStartX;
    float startY = $START_Y$;
    float endX = uEndX;
    float endY = $END_Y$;
    float width = endX - startX;
    float height = endY - startY;
    float coordX = fragCoord.x - uTranslateX;
    float coordY = fragCoord.y - uTranslateY;
    vec4 resultColor = vec4(0.0);
    $GRADIENT_COLOR_CODE$
    $HDR_GRADIENT_CODE$
    else if(uHdrStartPercent > 0.0 && coordY > (startY + height * uHdrStartPercent) && coordY < endY){
        half3 col = resultColor.rgb;
        col = toLinearSrgb(col);
        col = col * (($HDR_START$ - $HDR_END$) * (coordY - height * uHdrStartPercent - startY) / (height * (1 - uHdrStartPercent)) + $HDR_END$);
        col = fromLinearSrgb(col);
        return vec4(col * resultColor.a , resultColor.a);
    }
    return vec4(resultColor.r * resultColor.a, resultColor.g * resultColor.a, resultColor.b * resultColor.a, resultColor.a);
}

