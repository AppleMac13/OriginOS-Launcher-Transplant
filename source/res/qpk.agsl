uniform vec2 size; // 画布尺寸（必须传入）

// 三色线性渐变参数
uniform vec4 LinearColorLeft;    // 左侧颜色
uniform vec4 LinearColorMiddle;  // 中间颜色
uniform vec4 LinearColorRight;   // 右侧颜色
uniform float LinearMidOffset; // 中间颜色偏移量，取值范围 [0, 1]

// 椭圆渐变参数（仅影响透明度）
uniform vec2 center;       // 椭圆中心点在画布中的偏移量（例如 [0.5, 0.23]）
uniform vec4 ovalGradientColor; // 椭圆渐变的颜色值
uniform float ovalMidOffset1; // 椭圆渐变颜色偏移量1，取值范围 [0, 1]
uniform float ovalMidOffset2; // 椭圆渐变颜色偏移量2，取值范围 [0, 1]
uniform float uAlpha;
uniform float cornerRadius; //圆角大小
uniform vec4 strokeColor1;  //描边颜色1
uniform vec4 strokeColor2;  //描边颜色2

const float gradientWidth1 = 0.2; // 控制上下半区分界处的渐变带宽度
const float gradientWidth2 = 0.2; // 控制对角线分界处的渐变带宽度

const float strokeWidth1 = 6.0; //模糊描边1的宽度
const float strokeWidth2 = 3.0; //锐利描边2的宽度

// 计算点到圆角矩形的有符号距离场
float roundedRectSDF(float2 position, float2 dimensions, float radius) {
    float2 q = abs(position) - dimensions + radius;
    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - radius;
}

//计算下半边第一层描边
half4 calculateStrokeEffect(vec2 coord) {
    half4 baseColor = vec4(0.0, 0.0, 0.0, 0.0);

    // 转换坐标到中心点
    float2 center = size / 2.0;
    float2 localCoord = coord - center;

    // 计算圆角矩形的SDF值
    float2 dimensions = size / 2.0;
    float distance = roundedRectSDF(localCoord, dimensions, cornerRadius);

    // 使用SDF值直接创建模糊效果
    // 这是一个近似，但对于视觉效果已足够
    float blurAmount = 8.0;
    float blurredStroke = smoothstep(blurAmount, -blurAmount, abs(distance) - strokeWidth1/2.0);

    float normalizedY = localCoord.y / (size.y / 2.0);
    float strokeFactor = smoothstep(-gradientWidth1, gradientWidth1, normalizedY);
    float finalStroke = pow(blurredStroke * strokeFactor, 0.5); // 添加非线性变换，使边缘更深，中间更浅

    // 描边颜色
    half3 strokeColor1 = strokeColor1.rgb;
    half strokeAlpha = finalStroke;

    // 混合描边和基础颜色
    return mix(
        baseColor,
        half4(strokeColor1, strokeAlpha),
        strokeAlpha
    );
}

//计算右下角第二层描边
half4 calculateStrokeEffect2(vec2 coord) {
    // 基础颜色
    half4 baseColor = vec4(0, 0, 0, 0);

    // 转换坐标到中心点
    float2 center = size / 2.0;
    float2 localCoord = coord - center;
    // 计算圆角矩形的SDF值
    float2 dimensions = size / 2.0;
    float distance = roundedRectSDF(localCoord, dimensions, cornerRadius);

    // 如果在圆角矩形外，返回透明色
    if (distance > 0.0) {
        return half4(0.0);
    }

    // 计算坐标在矩形中的归一化位置 (0-1)
    float2 normalizedPos = coord / size;

    // 计算内描边因子
    // 使用SDF创建精确的内描边效果
    float strokeFactor2 = 0.0;
    if (distance > -strokeWidth2 && distance <= 0.0) {
            strokeFactor2 = smoothstep(0.5, -0.5, distance) -
                                    smoothstep(-strokeWidth2 + 0.5, -strokeWidth2 - 0.5, distance);
    }

    // 第二条描边对角线：左上到右下方向 (y = -2.1x + 2.2)
    //调整斜率和截距，可调整右下角描边显示范围
    // 计算点到第二条对角线的距离
    float diagonal2Dist = -normalizedPos.x * 2.1 - normalizedPos.y + 2.2;

    // 创建对角线平滑过渡区域
    float region2Factor = smoothstep(gradientWidth2, -gradientWidth2, diagonal2Dist);

    // 计算最终的描边不透明度
    float strokeOpacity2 = region2Factor * strokeFactor2;

    // 确定点在哪个区域
    // 区域2：右下区域 (diagonal2Dist < 0)
    half4 finalColor = baseColor;

    // 应用右下区域描边
    if (diagonal2Dist < 0.0) {
        vec4 rightColor = vec4(strokeColor2.rgb, strokeColor2.a);
        float opacity = smoothstep(gradientWidth2, -gradientWidth2, diagonal2Dist) * strokeFactor2;
        finalColor = mix(finalColor, half4(rightColor.rgb, rightColor.a * opacity), opacity);
    }

    return finalColor;
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / size; // 标准化坐标 [0, 1]

    // 1. 从左到右的三色线性渐变
    half4 linearGrad;
    if (uv.x < LinearMidOffset) {
        linearGrad = mix(LinearColorLeft, LinearColorMiddle, uv.x / LinearMidOffset);
    } else {
        linearGrad = mix(LinearColorMiddle, LinearColorRight, (uv.x - LinearMidOffset) / (1.0 - LinearMidOffset));
    }

    // 2. 椭圆渐变
    float darkAreaRadius = ovalMidOffset2;  // 椭圆渐变中的内部深色渐变区域的比例
    float2 delta = (uv - center) * size / min(size.x, size.y);
    //减去中心竖直偏移量剩下的高度比例 *  目标椭圆深色渐变高度比例 / 内部深色渐变区域的比例
    float ellipseScaleY = (1 - center.y) * 0.85 / darkAreaRadius;
    //(目标椭圆深色渐变宽度比例 * width / height) / (2 * 内部深色渐变区域的比例)
    float ellipseScaleX = (0.75 * size.x / size.y) / (2 * darkAreaRadius);
    vec2 ellipseSize = vec2(ellipseScaleX, ellipseScaleY);
    float radius = length(delta / ellipseSize);
    //根据偏移量计算椭圆渐变的透明度区间值
    float alpha;
    if (radius < ovalMidOffset1) {
        alpha = mix(1.0, 0.9, radius / ovalMidOffset1); // 0%~ovalMidOffset1%: 完全不透明 (#000000)
    } else if (radius < ovalMidOffset2) {
        alpha = mix(0.9, 0.87, (radius - ovalMidOffset1) / (ovalMidOffset2 - ovalMidOffset1)); // ovalMidOffset1%~ovalMidOffset2%: 微变化
    } else {
        alpha = mix(0.87, 0.0, (radius - ovalMidOffset2) / (1 - ovalMidOffset2)); // ovalMidOffset2%~100%: 渐隐
    }

    //3. 描边颜色
    half4 strokeColor1 = calculateStrokeEffect(fragCoord);
    half4 strokeColor2 = calculateStrokeEffect2(fragCoord);
    half4 strokeColor = vec4(strokeColor2.rgb * strokeColor2.a, strokeColor2.a) + strokeColor1 * (1 - strokeColor2.a);

    // 4. 最终颜色：线性渐变 + 椭圆透明度遮罩 + 内描边
    // 注意：这里椭圆仅作为透明度遮罩，不覆盖颜色
    // 4. 混合结果
    half4 maskColor = mix(linearGrad, ovalGradientColor, alpha);
    half4 finalColor = vec4(strokeColor.rgb * strokeColor.a, strokeColor.a) + maskColor * (1.0 - strokeColor.a);

    //返回预乘后的颜色，否则透明度丢失
    return half4(finalColor.rgb * finalColor.a, finalColor.a);
}